# ChainPe Facilitator — gitignored .env (never commit real keys)

# Gas-paying key that submits settlements. NON-CUSTODIAL: it only pays gas and
# relays the payer's signed authorization; it never holds user funds.
FACILITATOR_PRIVATE_KEY=0xYOUR_GAS_KEY

# Networks to settle on (comma-separated): arbitrum-sepolia, arbitrum
NETWORKS=arbitrum-sepolia

# Optional RPC overrides (public defaults are used if unset)
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Port (Railway injects PORT automatically)
PORT=4500
