# ChainPe indexer — gitignored .env (never commit secrets)

# Postgres (Railway provides DATABASE_URL when you add a Postgres plugin).
DATABASE_URL=postgres://user:pass@host:5432/chainpe

# Network: arbitrum-sepolia (default) or arbitrum
NETWORK=arbitrum-sepolia
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Required: your ChainPeRegistry deployment (contracts/deployments/<network>.json).
CHAINPE_REGISTRY_ADDRESS=
# Optional: defaults to the canonical ERC-8004 Reputation Registry for the network.
# ERC8004_REPUTATION_REGISTRY=

# Required: the ChainPeRegistry deploy block. The Reputation Registry is shared,
# so indexing from genesis is never what you want.
START_BLOCK=
POLL_INTERVAL_MS=5000
LOG_CHUNK=10000

# HTTP port (Railway injects PORT automatically).
PORT=4600
