# Network the dashboard reads: arbitrum-sepolia (default) or arbitrum.
# Exposed to the browser for the register flow (chain id + contract addresses).
NEXT_PUBLIC_NETWORK=arbitrum-sepolia

# ChainPeRegistry deployment for the network.
# NEXT_PUBLIC_CHAINPE_REGISTRY_ADDRESS=
# Optional override (defaults to the canonical ERC-8004 Reputation Registry).
# NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=

# Optional: point at a deployed indexer for O(1) reads. When unset,
# the dashboard reads the registry + reputation directly on-chain via viem.
# INDEXER_URL=https://chainpe-indexer.example.com

# Where /docs redirects (the landing site's fumadocs pages).
# NEXT_PUBLIC_DOCS_URL=https://chainpe.app/docs
