{
  "name": "@chainpe/sdk",
  "version": "0.3.0",
  "description": "ChainPe SDK — add x402 USDC payments + on-chain ERC-8004 reputation to any app in 3 lines, on Arbitrum.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "x402",
    "sdk",
    "usdc",
    "payments",
    "micropayments",
    "ai-agents",
    "erc-8004",
    "reputation",
    "chainpe",
    "arbitrum"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saxux2/chainpe.git",
    "directory": "packages/chainpe-sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/saxux2/chainpe/tree/main/packages/chainpe-sdk#readme",
  "bugs": {
    "url": "https://github.com/saxux2/chainpe/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
