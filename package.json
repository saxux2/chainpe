{
  "name": "chainpe-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ChainPe — x402 payment + ERC-8004 reputation infrastructure for the Arbitrum agent economy",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:cli": "npm run build --workspace=@chainpe/cli",
    "build:agent": "npm run build --workspace=@chainpe/agent",
    "build:wallet": "npm run build --workspace=chainpe-wallet-mcp",
    "build:mcpb": "npm run build:mcpb --workspace=chainpe-wallet-mcp",
    "build:sdk": "npm run build --workspace=@chainpe/sdk",
    "build:ai-tools": "npm run build --workspace=@chainpe/ai-tools",
    "test:wallet": "npm run test --workspace=chainpe-wallet-mcp",
    "test:sdk": "npm run test --workspace=@chainpe/sdk",
    "test:ai-tools": "npm run test --workspace=@chainpe/ai-tools",
    "test": "npm run test --workspaces --if-present && npm run test:e2e:local",
    "test:e2e:local": "node --test e2e/local.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:a2a": "node e2e/agent-to-agent.mjs",
    "test:e2e:mainnet": "node e2e/mainnet-arbitrum-usdc.mjs",
    "dev": "npm run dev --workspace=@chainpe/cli",
    "dev:agent": "npm run dev --workspace=@chainpe/agent",
    "dev:dashboard": "npm run dev --prefix apps/dashboard",
    "dev:landing": "npm run dev --prefix apps/landing -- -p 3002",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "publish:cli": "npm publish --workspace=@chainpe/cli --access public",
    "publish:agent": "npm publish --workspace=@chainpe/agent --access public",
    "publish:sdk": "npm publish --workspace=@chainpe/sdk --access public",
    "publish:ai-tools": "npm publish --workspace=@chainpe/ai-tools --access public",
    "publish:all": "npm run publish:sdk && npm run publish:ai-tools && npm run publish:cli && npm run publish:agent"
  },
  "keywords": [
    "x402",
    "arbitrum",
    "ai-agents",
    "agent-economy",
    "micropayments",
    "pay-per-request",
    "http-402",
    "erc-8004",
    "reputation",
    "usdc"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@chainpe/sdk": "^0.3.0"
  }
}
