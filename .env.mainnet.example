# ─── ChainPe — Arbitrum One Mainnet Environment Template ─────────────────────
# Copy to .env and fill in real values. NEVER commit this file with real values.
# All secrets must live in Railway / Vercel secret stores or a local .env only.

# ─── Chain / RPC ─────────────────────────────────────────────────────────────
NETWORK=arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Recommended: a paid node (Alchemy, Infura, QuickNode) for reliability
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<YOUR_KEY>

# ─── Deployer / Contracts ────────────────────────────────────────────────────
# Funded EOA used for contract deployment (≈ 0.01 ETH covers all contracts on Arbitrum).
# ROTATE THIS KEY immediately after deploying and transferring ownership to Safe.
DEPLOYER_PRIVATE_KEY=0x<REPLACE — funded deployer key>

# Gnosis Safe multisig that will own the contracts post-deploy.
# Create at https://app.safe.global and select Arbitrum One.
OWNER_ADDRESS=0x<REPLACE — Gnosis Safe address>

# Etherscan V2 API key for Arbiscan contract verification.
ETHERSCAN_API_KEY=<REPLACE>

# ─── Mainnet contract addresses ──────────────────────────────────────────────
# ChainPe's own contracts (fill in after running deploy scripts).
CHAINPE_REGISTRY_ADDRESS=0x<REPLACE — ChainPeRegistryUpgradeable proxy>
POLICY_VAULT_ADDRESS=0x<REPLACE — PolicyVaultUpgradeable proxy>
# Canonical ERC-8004 registries on Arbitrum One (shared; do not redeploy).
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ─── Provider proxy facilitators ─────────────────────────────────────────────
# Coinbase CDP (primary on Arbitrum One; PayAI is the automatic fallback).
CDP_API_KEY_ID=<REPLACE>
CDP_API_KEY_SECRET=<REPLACE>

# ─── Facilitator (Railway service: chainpe-facilitator) ──────────────────────
# Networks this facilitator settles on (comma-separated).
NETWORKS=arbitrum,arbitrum-sepolia
# Gas-paying key that submits USDC settlement transactions.
# This key ONLY pays gas — it never holds user funds and cannot move unsigned USDC.
# Fund with ≥ 0.01 ETH per network. /health reports "degraded" below 0.002 ETH.
FACILITATOR_PRIVATE_KEY=0x<REPLACE — dedicated gas-paying key, never a fund-holding key>

# Comma-separated list of origins allowed to call /verify and /settle from browsers.
# Server-to-server calls (no Origin header) are always allowed.
ALLOWED_ORIGINS=https://chainpe.app,https://dashboard.chainpe.app

# Log level for pino structured logs (info, debug, warn, error).
LOG_LEVEL=info

# PORT is injected by Railway automatically — do not set manually in Railway.
# PORT=4500

# ─── Indexer (Railway service: chainpe-indexer) ──────────────────────────────
# Postgres connection string (Railway Postgres plugin injects this automatically).
DATABASE_URL=postgresql://user:password@host:5432/chainpe_arbitrum

# REQUIRED: block to start indexing from. Use the ChainPeRegistry deploy block —
# the Reputation Registry is shared, so never index from genesis.
START_BLOCK=<REPLACE — ChainPeRegistry deploy block number>

# How often to poll for new blocks (ms). Arbitrum blocks are ~250 ms.
POLL_INTERVAL_MS=5000
# Max blocks per getLogs request.
LOG_CHUNK=10000

# ─── Dashboard (Vercel / Railway) ────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=arbitrum
NEXT_PUBLIC_CHAINPE_REGISTRY=0x<REPLACE — same as CHAINPE_REGISTRY_ADDRESS>

# Optional: point at the indexer for ranked search. If unset, dashboard reads on-chain.
INDEXER_URL=https://<your-indexer>.up.railway.app

# ─── Canonical constants (do not change) ─────────────────────────────────────
# Arbitrum One native USDC (Circle, EIP-3009)
# USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Arbitrum Sepolia USDC (Circle test USDC)
# USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
