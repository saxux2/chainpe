# ─── Buyer (orchestrator / investment fund manager) ──────────────────────────
# Wallet that pays all seller agents. Needs Arbitrum Sepolia USDC.
# Get test USDC: https://faucet.circle.com  (select Arbitrum Sepolia)
# Payments need no ETH; add a little Sepolia ETH only if this wallet funds the
# sellers (fund-sellers.mjs) or posts feedback (autoFeedback does).
CHAINPE_PRIVATE_KEY=0x...

# ─── Research + digest demo sellers ───────────────────────────────────────────
# Each seller needs its OWN wallet — ERC-8004 blocks self-feedback.
# Generate fresh wallets: node gen-wallets.mjs
RESEARCH_PAYTO=0x...
RESEARCH_PAYTO_KEY=0x...
DIGEST_PAYTO=0x...
DIGEST_PAYTO_KEY=0x...

# ─── Investment agents ────────────────────────────────────────────────────────
# Arbitrum Price Agent — live ETH/ARB prices + DeFiLlama TVL (no LLM, $0.005/call)
PRICE_PAYTO=0x...
PRICE_PAYTO_KEY=0x...

# Arbitrum News Agent — Arbitrum news + Claude synthesis ($0.02/call)
NEWS_PAYTO=0x...
NEWS_PAYTO_KEY=0x...

# Arbitrum Analysis Agent — Claude BUY/SELL/HOLD on ETH with price targets ($0.05/call)
ANALYSIS_PAYTO=0x...
ANALYSIS_PAYTO_KEY=0x...

# Arbitrum DEX Agent — best-route quotes on Arbitrum One via KyberSwap ($0.01/call).
# Quote-only: it never signs or executes a swap.
DEX_PAYTO=0x...
DEX_PAYTO_KEY=0x...

# ─── Shared ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Network: arbitrum-sepolia (default) or arbitrum (real USDC).
CHAINPE_NETWORK=arbitrum-sepolia

# ChainPeRegistry for the network (docs/DEPLOYMENTS.md). Needed to register
# sellers and for registry discovery. ERC-8004 registries default to the
# canonical addresses.
CHAINPE_REGISTRY_ADDRESS=0x...

# Settlement: sellers use PayAI by default (no key, no config). Optional:
# CHAINPE_FACILITATOR_URL=https://your-facilitator.example.com   # another x402 v2 facilitator
# CHAINPE_FACILITATOR_KEY=0x...                                  # settle in-process (needs ETH)

# Optional: payment-verified reputation from a ChainPe indexer
# CHAINPE_INDEXER_URL=https://...

# ─── Ports / pricing (optional) ───────────────────────────────────────────────
RESEARCH_PROXY_PORT=4501
RESEARCH_BACKEND_PORT=5101
RESEARCH_PRICE=0.01
DIGEST_PROXY_PORT=4502
DIGEST_BACKEND_PORT=5102
DIGEST_PRICE=0.01
PRICE_PROXY_PORT=4503
PRICE_BACKEND_PORT=5103
PRICE_PRICE=0.005
NEWS_PROXY_PORT=4504
NEWS_BACKEND_PORT=5104
NEWS_PRICE=0.02
ANALYSIS_PROXY_PORT=4505
ANALYSIS_BACKEND_PORT=5105
ANALYSIS_PRICE=0.05
DEX_PROXY_PORT=4506
DEX_BACKEND_PORT=5106
DEX_PRICE=0.01

# ─── Paper portfolio seed (investment-orchestrator.mjs) ──────────────────────
PORTFOLIO_USDC=10.0
PORTFOLIO_ETH=0

# ─── Model overrides (optional) ───────────────────────────────────────────────
# RESEARCH_MODEL=claude-sonnet-5
# DIGEST_MODEL=claude-haiku-4-5-20251001
# NEWS_MODEL=claude-haiku-4-5-20251001
# ANALYSIS_MODEL=claude-sonnet-5
