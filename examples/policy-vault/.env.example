# Deployed PolicyVault (deploy with:
#   cd contracts && npm run deploy:policyvault:sepolia)
POLICY_VAULT_ADDRESS=0x...

# Three DISTINCT keys for the three roles.
OWNER_KEY=0x...      # funds the vault + sets policy (needs USDC + a little ETH)
SESSION_KEY=0x...    # the agent's session signer (needs nothing — pays no gas)
RELAYER_KEY=0x...    # submits spends (needs a little ETH for gas)

# Where spends go (e.g. a provider payTo).
RECIPIENT=0x...

# Network: arbitrum-sepolia (default) or arbitrum. USDC is the network's native
# Circle USDC from the SDK. Test USDC: https://faucet.circle.com (Arbitrum Sepolia).
CHAINPE_NETWORK=arbitrum-sepolia
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
