# Consumer wallet that pays for services (needs a little Arbitrum Sepolia USDC).
# Get test USDC at https://faucet.circle.com (select Arbitrum Sepolia).
CHAINPE_PRIVATE_KEY=0x...

# LLM key for the agent.
ANTHROPIC_API_KEY=sk-ant-...

# Network: arbitrum-sepolia (default) or arbitrum (real USDC).
# CHAINPE_NETWORK=arbitrum-sepolia

# Optional: include ChainPe-registered services in discovery, and read
# payment-verified reputation from an indexer. The ERC-8004 registries
# default to the canonical addresses.
# CHAINPE_REGISTRY_ADDRESS=0x...
# CHAINPE_INDEXER_URL=https://...
