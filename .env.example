# ChainPe Environment Variables (Arbitrum)
# Copy to .env and fill in your values.  NEVER commit your real .env.
#
# .env is gitignored. Secrets (private keys) live ONLY here, never in source.

# ============================================================================
# CONTRACT DEPLOYMENT (contracts/ — Hardhat)
# ============================================================================

# Funded deployer private key (0x-prefixed, 64 hex chars). Used by hardhat.config.ts
# to sign deployments to Arbitrum Sepolia / Arbitrum One. KEEP SECRET.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Etherscan V2 API key (one key verifies on Arbiscan for Arbitrum One + Sepolia).
ETHERSCAN_API_KEY=

# RPC overrides (optional — public defaults are used if unset; use a paid RPC in production)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Registry constructor params (optional — deploy.ts has defaults)
# FEE_TOKEN_ADDRESS defaults to Circle USDC for the target network:
#   Arbitrum Sepolia: 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
#   Arbitrum One:     0xaf88d065e77c8cC2239327C5EDb3A432268e5831
FEE_TOKEN_ADDRESS=
FEE_RECIPIENT=                 # treasury for registration fees (defaults to deployer)
REGISTRATION_FEE_USDC=1.0      # human-readable USDC fee per register/update
IDENTITY_REGISTRY=             # defaults to the canonical ERC-8004 Identity Registry

# ============================================================================
# PROVIDER CONFIGURATION (chainpe CLI)
# ============================================================================

# Your EVM wallet address (0x...) that receives payments on Arbitrum.
CHAINPE_WALLET_ADDRESS=0xYOUR_ADDRESS

# Backend API URL to proxy
CHAINPE_TARGET=http://localhost:3000

# Price per request (USDC)
CHAINPE_PRICE=0.01

# Payment token (USDC only — x402 "exact" settles in USDC)
CHAINPE_TOKEN=USDC

# Service metadata
CHAINPE_SERVICE_NAME=My AI Service
CHAINPE_SERVICE_DESCRIPTION=An AI-powered service
CHAINPE_TAGS=ai,nlp,research

# Proxy port
CHAINPE_PORT=4402

# Network: arbitrum-sepolia (testnet) or arbitrum (Arbitrum One mainnet)
CHAINPE_NETWORK=arbitrum-sepolia

# Deployed ChainPeRegistry contract address (from contracts/deployments/<network>.json)
CHAINPE_REGISTRY_ADDRESS=

# Log level: verbose, normal, quiet
CHAINPE_LOG_LEVEL=normal

# ============================================================================
# CONSUMER / AGENT CONFIGURATION (chainpe-wallet MCP, chainpe-agent)
# ============================================================================

# Agent wallet private key (0x...). Used to sign x402 USDC payments.
# In the MCP extension this is stored in the OS keychain, not on disk.
CHAINPE_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY

# Network: arbitrum-sepolia (testnet) or arbitrum (Arbitrum One mainnet)
NETWORK=arbitrum-sepolia

# Budget limits (USDC)
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00

# ERC-8004 registries — optional overrides; the canonical registries are used by default:
#   Arbitrum Sepolia: Identity 0x8004A818BFB912233c491871b3d84c89A494BD9e
#                     Reputation 0x8004B663056A597Dffe9eCcC1965A193B7388713
#   Arbitrum One:     Identity 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
#                     Reputation 0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=

# LLM (chainpe-agent)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o
AGENT_LLM_API_KEY=your-api-key

# ============================================================================
# ARBITRUM RESOURCES
# ============================================================================
# Testnet USDC faucet:  https://faucet.circle.com  (select Arbitrum Sepolia)
# Sepolia explorer:     https://sepolia.arbiscan.io
# Mainnet explorer:     https://arbiscan.io

# ============================================================================
# FACILITATOR
# ============================================================================
# The provider proxy verifies + settles payments through an ordered list of
# facilitators and fails over to the next one if a facilitator is unreachable.
# Defaults: Arbitrum One → Coinbase CDP (when the keys below are set) → PayAI;
#           Arbitrum Sepolia → PayAI (CDP has no Sepolia support).
# Coinbase CDP API keys (https://portal.cdp.coinbase.com) — only needed for CDP:
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional: use a single facilitator instead (e.g. your own services/chainpe-facilitator).
CHAINPE_FACILITATOR_URL=
